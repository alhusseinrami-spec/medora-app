# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection strings. On Vercel with Neon both are filled in for you.
# DATABASE_URL may be pooled; DATABASE_URL_UNPOOLED must be a direct connection (used for migrations).
# Self-hosting with one plain Postgres? Set both to the same value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medora"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/medora"

# 32+ random characters. Encrypts authenticator secrets and, from Phase 2, account tokens.
# Generate with:  openssl rand -base64 48
# Keep it safe: if it is lost, everyone must set up two-step sign-in again.
APP_ENCRYPTION_KEY=""

# Public address of the app, e.g. https://command.medora-care.com
APP_URL="http://localhost:3000"

# Claude API key from console.anthropic.com. Without it the app works, and the assistant shows "not connected".
ANTHROPIC_API_KEY=""
# Optional: override the model (default claude-opus-5-5).
# AI_MODEL="claude-opus-5-5"

# Only for local HTTP testing of a production build. Never set this on a real server.
# ALLOW_INSECURE_COOKIES=1

# Protects /api/cron/tick, which runs reminders and nightly clean-up. Vercel Cron sends it automatically.
# 32+ random characters:  openssl rand -base64 48
CRON_SECRET=""

# Lets Nour (the ElevenLabs voice assistant) read your day and queue tasks or reminders for approval.
# 32+ random characters. Put the same value in ElevenLabs as a secret, never in chat. Leave empty to keep Nour off.
NOUR_API_KEY=""

# Where approved field-sales orders and proforma requests are sent (your accounting system, or a
# connector such as Make or Zapier in front of it). Each is a JSON POST signed with
# X-Medora-Signature: sha256=<HMAC-SHA256 of the body with the secret below>. Leave empty to keep orders here only;
# approved orders wait and go out as soon as both are set.
ACCOUNTING_WEBHOOK_URL=""
# 32+ random characters, shared with the receiver:  openssl rand -base64 48
ACCOUNTING_WEBHOOK_SECRET=""

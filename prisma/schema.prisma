// Medora Executive Assistant — database schema.
// Change only through `npm run db:migrate` so every change is versioned.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (unpooled) connection. On Vercel + Neon this is set for you;
  // elsewhere set it to the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum TaskStatus {
  TODO
  DOING
  WAITING
  DONE
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  DISMISSED
}

enum ApprovalStage {
  SUGGESTION
  DRAFT
  APPROVED
  COMPLETED
  REJECTED
}

enum ContactCategory {
  CUSTOMER
  SUPPLIER
  STAFF
  PARTNER
  OTHER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          Role      @default(STAFF)
  passwordHash  String
  mfaSecretEnc  String?
  mfaEnabled    Boolean   @default(false)
  timeZone      String    @default("Asia/Beirut")
  locale        String    @default("en")
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  tasksOwned    Task[]           @relation("TaskOwner")
  tasksAssigned Task[]           @relation("TaskAssignee")
  projects      Project[]
  events        Event[]
  reminders     Reminder[]
  contacts      Contact[]
  notifications Notification[]
  approvals     Approval[]       @relation("ApprovalOwner")
  decisions     Approval[]       @relation("ApprovalDecider")
  conversations Conversation[]
  memories      Memory[]
  auditLogs     AuditLog[]
  executionLogs ExecutionLog[]
  integrations  IntegrationAccount[]
  emails        Email[]
  documents     Document[]
  automations   AutomationRule[]
  settings      Setting[]

  @@map("users")
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaPassed   Boolean   @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id     String   @id @default(cuid())
  email  String
  ip     String?
  ok     Boolean
  at     DateTime @default(now())

  @@index([email, at])
  @@map("login_attempts")
}

model Project {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("active")
  due       DateTime?
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  notes       String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(P3)
  due         DateTime?
  position    Float      @default(0)
  source      String     @default("app")
  ownerId     String
  owner       User       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  doneAt      DateTime?
  reminders   Reminder[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Event {
  id         String     @id @default(cuid())
  title      String
  start      DateTime
  end        DateTime
  allDay     Boolean    @default(false)
  location   String     @default("")
  notes      String     @default("")
  source     String     @default("app")
  externalId String?
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  reminders  Reminder[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ownerId, start])
  @@map("events")
}

model Reminder {
  id        String         @id @default(cuid())
  title     String
  dueAt     DateTime
  status    ReminderStatus @default(PENDING)
  firedAt   DateTime?
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  eventId   String?
  event     Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, dueAt])
  @@map("reminders")
}

model Contact {
  id        String          @id @default(cuid())
  name      String
  company   String          @default("")
  jobTitle  String          @default("")
  email     String          @default("")
  phone     String          @default("")
  whatsapp  String          @default("")
  category  ContactCategory @default(OTHER)
  tags      String[]        @default([])
  notes     String          @default("")
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks     Task[]
  events    Event[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId, name])
  @@map("contacts")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String    @default("")
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model Approval {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation("ApprovalOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  detail       String        @default("")
  payload      Json          @default("{}")
  stage        ApprovalStage @default(DRAFT)
  requestedBy  String        @default("ai")
  decidedById  String?
  decidedBy    User?         @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  completedAt  DateTime?
  result       String        @default("")
  resultLink   String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, stage])
  @@map("approvals")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New conversation")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        Json
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Memory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    @default("preference")
  content    String
  source     String    @default("user")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("memories")
}

model ExecutionLog {
  id         String   @id @default(cuid())
  kind       String
  name       String
  status     String
  input      Json?
  output     Json?
  error      String?
  durationMs Int      @default(0)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  at         DateTime @default(now())

  @@index([at])
  @@map("execution_logs")
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorKind String  @default("user")
  action   String
  entity   String
  entityId String?
  ip       String?
  meta     Json?
  at       DateTime @default(now())

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Setting {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@unique([userId, key])
  @@map("settings")
}

// ---- Later phases: tables exist now so the schema is complete; screens arrive with their phase. ----

model IntegrationAccount {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  accountEmail String   @default("")
  scopes      String[]  @default([])
  tokensEnc   String
  status      String    @default("connected")
  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, provider, accountEmail])
  @@map("integration_accounts")
}

model Email {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  externalId    String
  threadId      String
  fromAddress   String
  subject       String
  snippet       String   @default("")
  labels        String[] @default([])
  summary       String   @default("")
  waitingReply  Boolean  @default(false)
  receivedAt    DateTime

  @@unique([userId, provider, externalId])
  @@map("emails")
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  textContent String   @default("")
  summary     String   @default("")
  createdAt   DateTime @default(now())

  @@map("documents")
}

model AutomationRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  trigger       Json
  conditions    Json     @default("[]")
  actions       Json     @default("[]")
  needsApproval Boolean  @default(true)
  trusted       Boolean  @default(false)
  status        String   @default("paused")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("automation_rules")
}
